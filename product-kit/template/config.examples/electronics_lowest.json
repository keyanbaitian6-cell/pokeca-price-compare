      "WH1000XM5 ブラック": "Sony WH-1000XM5 ブラック"
    }
  },
  "alerts": {
    "highlight_spread_rate": 0.05,
    "highlight_spread_yen": 3000,
    "targets": [
      {
        "item": "Sony WH-1000XM5 ブラック",
        "condition": "新品",
        "target_price_yen": 40000
      }
    ]
  },
  "sources": [
    {
      "id": "shop_a",
      "label": "家電ショップA（URLを書き換えて使用）",
      "enabled": true,
      "type": "json_ld",
      "urls": [
        "https://shop-a.example/products/wh-1000xm5"
      ],
      "default_condition": "新品"
    },
    {
      "id": "shop_b",
      "label": "家電ショップB（URLとセレクタを書き換えて使用）",
      "enabled": true,
      "type": "html_single",
      "urls": [
        "https://shop-b.example/item/wh-1000xm5"
      ],
      "default_condition": "新品",
      "selectors": {
        "name": "h1.product-title",
