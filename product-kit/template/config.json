{
  "project": {
    "title": "マイ価格比較ダッシュボード（デモ）",
    "comparison_mode": "lowest",
    "currency_symbol": "¥",
    "spreadsheet_id": "",
    "manual_update_url": ""
  },
  "safety": {
    "request_delay_seconds": 2.0,
    "timeout_seconds": 20.0,
    "max_pages_per_source": 5,
    "respect_robots_txt": true,
    "user_agent": "PersonalPriceMonitorKit/1.0 (+personal-low-frequency-use)"
  },
  "notifications": {
    "enabled": true,
    "notify_on_target_hit": true,
    "notify_on_error": true,
    "always_notify_summary": false
  },
  "normalization": {
    "strip_phrases": [
      "【新品・送料無料】",
      "【送料無料】",
      "【新品】",
      "【特価】",
      "（美品）",
      "（税込）",
      "税込"
    ],
    "strip_regex": [
      "\\[[^\\]]+\\]"
    ],
    "aliases": {
      "SONY WH1000XM5 ワイヤレスヘッドホン": "Sony WH-1000XM5 ワイヤレスヘッドホン",
      "Switch 有機EL ホワイト": "Nintendo Switch 有機ELモデル ホワイト"
    }
  },
  "alerts": {
    "highlight_spread_rate": 0.05,
    "highlight_spread_yen": 2000,
    "targets": [
      {
        "item": "Sony WH-1000XM5 ワイヤレスヘッドホン",
        "condition": "新品",
        "target_price_yen": 42000
      },
      {
        "item": "Nintendo Switch 有機ELモデル ホワイト",
        "condition": "新品",
        "target_price_yen": 35000
      },
      {
        "item": "RICOH GR III コンパクトデジタルカメラ",
        "condition": "中古",
        "target_price_yen": 135000
      }
    ]
  },
  "sources": [
    {
      "id": "shop_alpha",
      "label": "サンプル店Alpha",
      "enabled": true,
      "type": "html_list",
      "url": "sample_pages/shop_alpha_electronics.html",
      "default_condition": "新品",
      "selectors": {
        "item": "article.product-card",
        "name": ".product-title",
        "price": ".product-price",
        "condition": ".product-condition",
        "stock": ".stock-badge",
        "link": "a.product-link"
      }
    },
    {
      "id": "shop_beta",
      "label": "サンプル店Beta",
      "enabled": true,
      "type": "html_list",
      "url": "sample_pages/shop_beta_electronics.html",
      "default_condition": "新品",
      "selectors": {
        "item": "div.item-box",
        "name": "a.item-name",
        "price": "strong.price",
        "condition": "span.cond",
        "stock": "span.status",
        "link": "a.item-name"
      }
    },
    {
      "id": "shop_gamma",
      "label": "サンプル店Gamma",
      "enabled": true,
      "type": "json_ld",
      "url": "sample_pages/shop_gamma_jsonld.html",
      "default_condition": "新品"
    },
    {
      "id": "shop_delta",
      "label": "サンプル店Delta",
      "enabled": true,
      "type": "csv_feed",
      "url": "sample_pages/shop_delta_feed.csv",
      "default_condition": "新品",
      "columns": {
        "name": "商品名",
        "condition": "状態",
        "price": "価格",
        "stock": "在庫",
        "url": "URL"
      }
    }
  ]
}
